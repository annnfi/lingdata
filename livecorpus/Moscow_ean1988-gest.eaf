    <TIER ANNOTATOR="@amf2007f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="words" PARENT_REF="gestType@ean1988f"
        PARTICIPANT="@ean1988f" TIER_ID="gestComment@ean1988f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1659"
                TIME_SLOT_REF1="ts366" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>голова была повернута во время предыдущей аннотации, тело Елена придвинула чтобы быть ближе к собеседнику, что намекает на то что она секретничала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1669"
                TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts391">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1670"
                TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts403">
                <ANNOTATION_VALUE>возможно это указательный жест, она немного в начале показала на собеседника, и еще рука резко поднялась, как будто она скорее хочет показать на само наличие запроса</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1677"
                TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>удерживает руку в кулаке, зависла, чтобы вспомнить</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1688"
                TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>выделяю голову на весь момент, потому что вначале она была повернута с предыдущей аннотации и Елена вспоминала, а потом она ее развернула на собеседника</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1710"
                TIME_SLOT_REF1="ts462" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>эмблема, потому что Елена пожатием плечами усиливает "неприятность занятия" и этим также подчеркивает свою неловкость</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1717"
                TIME_SLOT_REF1="ts488" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>рука была поднята еще в предыдущей аннотации</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1722"
                TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>еще это может быть эмблема со значением искренности, честности, но тут она скорее подчеркивает что это ее личное субъективное мнение</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1761"
                TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>возможно что это также прагматический жест и привлечение внимания, но Елена сильно развела руки, чтобы показать большое количество</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1872"
                TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>голова еще будет отвернута от собеседника до 13:08:316. Периодически Елена её поворачивает в другую сторону. руки будут в этом положении до 12:31:835</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1788"
                TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>голова была повернута еще в предыдущей аннотации</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1792"
                TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts687">
                <ANNOTATION_VALUE>немного крутит головой, говоря, что там много всего непонятного и не совсем приятного ей</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1840"
                TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>Елена отмахивается от своих слов, далее она будет держать скрещенные руки(основное положение) до конца</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1848"
                TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>не уверена, что это прямо эмблема, может быть просто адаптор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1856"
                TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>ноги еще будут покачивать кресло до 12:55:253</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1860"
                TIME_SLOT_REF1="ts884" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>голова еще будет отвернута до</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1867"
                TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>ноги дальше будут поворачивать кресло до 13:05:310</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1908"
                TIME_SLOT_REF1="ts1021" TIME_SLOT_REF2="ts1037">
                <ANNOTATION_VALUE>будет крутить стул до 13:32:800</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1919"
                TIME_SLOT_REF1="ts1051" TIME_SLOT_REF2="ts1062">
                <ANNOTATION_VALUE>голова будет отвернута до 13:35:380</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1930"
                TIME_SLOT_REF1="ts1093" TIME_SLOT_REF2="ts1098">
                <ANNOTATION_VALUE>я не размечаю пожимание плечами, потому что они у Елены всегда поднимаются во время смеха</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1954"
                TIME_SLOT_REF1="ts1139" TIME_SLOT_REF2="ts1144">
                <ANNOTATION_VALUE>голова будет повернута до 13:54:293</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1952"
                TIME_SLOT_REF1="ts1145" TIME_SLOT_REF2="ts1151">
                <ANNOTATION_VALUE>ноги еще будут крутить стул до 13:56</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
